POSTGRES_USER=democrai
POSTGRES_PASSWORD=democrai-secret
POSTGRES_DB=postgres

REDIS_PORT=6379
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MILVUS_PORT=19530

NEO4J_AUTH=neo4j/democrai-neo4j-secret

# Internal MinIO used by Milvus standalone.
MILVUS_MINIO_ACCESS_KEY_ID=minioadmin
MILVUS_MINIO_SECRET_ACCESS_KEY=minioadmin

# S3-compatible media storage used by storage.media.type=s3 in config.yaml.
MEDIA_S3_PORT=9000
MEDIA_S3_CONSOLE_PORT=9001
MEDIA_S3_BUCKET=democrai-media
MEDIA_S3_ACCESS_KEY=democrai
MEDIA_S3_SECRET_KEY=democrai-minio-secret
