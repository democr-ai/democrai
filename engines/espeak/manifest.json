{
  "id": "espeak",
  "name": "eSpeak",
  "kind": "tts",
  "entrypoint": "engines.espeak.engine:EspeakEngine",
  "models": {
    "catalog": {
      "enabled": true,
      "path": "models/catalog.json"
    }
  },
    "install": {
        "access": [
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_bin}/espeak"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_bin}/espeak-ng"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_config}/fsspec"
      },
            {
                "resource_type": "filesystem",
                "operation": "modify",
                "target": "{engine_config}/fsspec"
            }
        ],
        "access_by_os": {
            "linux": [
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/usr/local/bin/espeak-ng"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/usr/local/bin/espeak"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/usr/bin/espeak-ng"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/usr/bin/espeak"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/bin/espeak-ng"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/bin/espeak"
                }
            ],
            "darwin": [
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/opt/homebrew/bin/espeak-ng"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/opt/homebrew/bin/espeak"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/opt/local/bin/espeak-ng"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/opt/local/bin/espeak"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/usr/local/bin/espeak-ng"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "/usr/local/bin/espeak"
                }
            ],
            "windows": [
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "C:\\Program Files\\eSpeak NG\\espeak-ng.exe"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "C:\\Program Files\\eSpeak NG\\espeak.exe"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "C:\\Program Files (x86)\\eSpeak NG\\espeak-ng.exe"
                },
                {
                    "resource_type": "filesystem",
                    "operation": "execute",
                    "target": "C:\\Program Files (x86)\\eSpeak NG\\espeak.exe"
                }
            ]
        },
