      "tags": [
        "vllm",
        "chat",
        "reasoning",
        "local",
        "huggingface",
        "qwen",
        "image_to_text",
        "tool_calling"
      ],
      "capabilities": [
        "chat",
        "reasoning",
        "image_to_text",
        "tool_calling"
      ],
      "extended_capabilities": [
        "offline"
      ],
      "interfaces": [
        "text_to_text"
      ],
      "requirements": {
        "ram_gb": 4,
        "vram_gb": 12,
        "storage_gb": 10
      },
      "provisioning": {
        "mode": "catalog",
        "download": {
          "strategy": "huggingface_snapshot",
          "artifacts_required": [
            "weights"
          ]
        }
      },
      "artifacts": [
        {
          "id": "weights",
          "kind": "model",
          "format": "hf_snapshot",
          "required": true,
          "target": "models/Qwen3.5-4B",
          "source": {
            "type": "huggingface",
            "repo": "Qwen/Qwen3.5-4B",
            "snapshot": true
          }
        }
      ],
      "runtime": {
        "execution_mode": "standard",
        "artifact_ref": "weights",
        "model_ref": "Qwen/Qwen3.5-4B",
        "defaults": {
          "generation": {
            "temperature": 0.7,
            "top_p": 0.8,
            "top_k": 20,
            "max_tokens": 512
          },
          "runtime": {
            "dtype": "auto",
            "enable_prefix_caching": true,
            "enforce_eager": true,
            "gpu_util": 0.9,
            "context_length": 8192,
            "reasoning_parser": "qwen3",
            "output_parser": "vllm_qwen",
            "trust_remote_code": true
          }
        }
      },
      "features": {
        "reasoning": {
          "supported": true,
          "activation": {
            "mode": "extra_param",
            "param": "reasoning",
            "type": "boolean",
            "default": false,
            "values": [
              true,
              false
            ]
          }
        }
      },
      "metadata": {
        "source": "qwen"
      }
    },
