{
  "id": "openai_whisper",
  "name": "OpenAI Whisper",
  "kind": "stt",
  "entrypoint": "engines.openai_whisper.engine:OpenAIWhisperEngine",
  "models": {
    "catalog": {
      "enabled": true,
      "path": "models/catalog.json"
    },
    "source_modes": [
      "catalog",
      "definition"
    ],
    "custom_definition": {
      "enabled": true,
      "schema": "models/schemas/add_model.json"
    },
    "artifact_upload": {
      "enabled": false
    }
  },
  "runtime": {
    "allowed_config_urls": "base_url",
    "access": [
      {
        "resource_type": "network",
        "operation": "connect",
        "target": "https://api.openai.com/*"
      },
      {
        "resource_type": "network",
        "operation": "send",
        "target": "https://api.openai.com/*"
      },
      {
        "resource_type": "network",
        "operation": "receive",
        "target": "https://api.openai.com/*"
      }
    ]
  },
  "provider": {
    "id": "openai_whisper",
    "label": "OpenAI Whisper",
    "kind": "stt",
    "deployment": "remote",
    "model_source": "engine_catalog",
    "runtime_methods": [
      "transcribe"
    ],
    "icon_url": "engines/openai_whisper/assets/icon.png",
    "dependencies": [
      {
        "dependency_key": "openai",
        "module": "openai",
        "label": "openai",
        "pip_packages": [
          "openai"
        ]
      }
    ],
    "configurable": true,
    "config_schema": [
      {
        "name": "api_key",
        "label": "API Key",
        "type": "password",
        "placeholder": "sk-...",
        "validations": [
          {
            "rule": "required",
            "message": "API key is required"
          }
        ]
      },
      {
        "name": "base_url",
        "label": "Base URL",
        "type": "text",
        "value": "https://api.openai.com/v1"
      }
    ],
    "encrypted_keys": [
      "api_key"
    ],
    "description": "Remote OpenAI speech-to-text provider.",
    "capabilities": [
      "stt"
    ]
  }
}
