{
  "id": "whisper",
  "name": "Whisper (local)",
  "kind": "stt",
  "entrypoint": "engines.whisper.engine:WhisperEngine",
  "install": {
    "env": {
      "HF_HOME": "{engine_cache}/huggingface",
      "HF_HUB_CACHE": "{engine_cache}/huggingface/hub",
      "HF_DATASETS_CACHE": "{engine_cache}/huggingface/datasets",
      "NETRC": "{engine_config}/netrc",
      "FSSPEC_CONFIG_DIR": "{engine_config}/fsspec"
    },
    "allowed_imports": [
      "ctypes",
      "_ctypes",
      "cffi",
      "_cffi_backend"
    ],
    "access": [
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_cache}/huggingface"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_cache}/huggingface"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_cache}/huggingface"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_config}/netrc"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_config}/fsspec"
      }
    ]
  },
  "runtime": {
    "env": {
      "HF_HOME": "{engine_cache}/huggingface",
      "HF_HUB_CACHE": "{engine_cache}/huggingface/hub",
      "HF_DATASETS_CACHE": "{engine_cache}/huggingface/datasets",
      "NETRC": "{engine_config}/netrc",
      "FSSPEC_CONFIG_DIR": "{engine_config}/fsspec"
    },
    "allowed_imports": [
      "ctypes",
      "_ctypes",
      "cffi",
      "_cffi_backend"
    ],
    "access": [
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_cache}/huggingface"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_cache}/huggingface"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_cache}/huggingface"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_config}/netrc"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_config}/fsspec"
      }
    ]
  },
  "models": {
    "catalog": {
      "enabled": true,
      "path": "models/catalog.json"
    },
    "source_modes": [
      "catalog",
      "definition"
    ],
    "custom_definition": {
      "enabled": true,
      "schema": "models/schemas/add_model.json"
    },
    "artifact_upload": {
      "enabled": false
    }
  },
  "provider": {
    "id": "whisper",
    "label": "Whisper (local)",
    "kind": "stt",
    "deployment": "local",
    "model_source": "engine_catalog",
    "runtime_methods": [
      "transcribe"
    ],
    "local_section": "local_audio",
    "icon_url": "engines/whisper/assets/icon.png",
    "dependencies": [
      {
        "dependency_key": "faster_whisper",
        "module": "faster_whisper",
        "label": "faster-whisper",
        "pip_packages": [
          "faster-whisper==1.2.1",
          "ctranslate2==4.6.1",
          "av",
          "onnxruntime",
          "tokenizers",
          "huggingface-hub",
          "tqdm"
        ]
      }
    ],
    "configurable": false,
    "config_schema": [],
    "encrypted_keys": [],
    "description": "Local speech-to-text engine for transcription workloads.",
    "capabilities": [
      "stt",
      "offline"
    ]
  }
}
