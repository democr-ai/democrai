{
  "id": "llamacpp",
  "name": "llama.cpp",
  "kind": "llm",
  "entrypoint": "engines.llamacpp.engine:LlamaCppEngine",
  "license": {
    "name": "llama.cpp and llama-cpp-python downstream licenses",
    "file": "LICENSE"
  },
  "install": {
    "python_dependencies": [
      "llama-cpp-python"
    ],
    "access": [
      {
        "resource_type": "network",
        "operation": "receive",
        "target": "https://pypi.org"
      },
      {
        "resource_type": "network",
        "operation": "receive",
        "target": "https://files.pythonhosted.org"
      },
      {
        "resource_type": "network",
        "operation": "receive",
        "target": "https://abetlen.github.io"
      },
      {
        "resource_type": "network",
        "operation": "receive",
        "target": "https://github.com"
      },
      {
        "resource_type": "network",
        "operation": "receive",
        "target": "https://release-assets.githubusercontent.com"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "delete",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_config}/fsspec"
      }
    ],
    "env": {
      "FSSPEC_CONFIG_DIR": "{engine_config}/fsspec"
    },
    "allowed_imports": [
      "ctypes",
      "_ctypes"
    ]
  },
  "runtime": {
    "python_dependencies": [
      "llama-cpp-python"
    ],
    "access": [
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "delete",
        "target": "{engine_cache}"
      },
      {
        "resource_type": "filesystem",
        "operation": "read",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "create",
        "target": "{engine_config}/fsspec"
      },
      {
        "resource_type": "filesystem",
        "operation": "modify",
        "target": "{engine_config}/fsspec"
      }
    ],
    "env": {
      "FSSPEC_CONFIG_DIR": "{engine_config}/fsspec"
    },
    "allowed_imports": [
      "ctypes",
      "_ctypes"
    ]
  },
  "models": {
    "catalog": {
      "enabled": true,
      "path": "models/catalog.json"
    },
    "source_modes": [
      "catalog",
      "definition",
      "artifact"
    ],
    "custom_definition": {
      "enabled": true,
      "schema": "models/schemas/add_model.json"
    },
    "artifact_upload": {
      "enabled": true,
      "schema": "models/schemas/upload_model.json",
      "accepted_formats": [
        ".gguf"
      ]
    }
  },
  "provider": {
    "id": "llamacpp",
    "label": "llama.cpp",
    "kind": "llm",
    "deployment": "local",
    "model_source": "inventory",
    "accepted_model_formats": [
      "gguf"
    ],
    "model_capabilities": [
      "chat",
      "tool_calling",
      "reasoning"
    ],
    "runtime_methods": [
      "generate_completion",
      "generate_stream"
    ],
    "local_section": "local_llm",
    "icon_url": "engines/llamacpp/assets/icon.png",
    "description": "Runs GGUF models locally with direct runtime control.",
    "dependencies": [
      {
        "dependency_key": "llama_cpp",
        "module": "llama_cpp",
        "label": "llama-cpp-python",
        "pip_packages": [
          "llama-cpp-python"
        ]
      }
    ],
    "configurable": false,
    "config_schema": [],
    "encrypted_keys": [],
    "capabilities": [
      "chat",
      "tool_calling",
      "offline"
    ]
  }
}
