{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llama.cpp custom model definition",
  "type": "object",
  "required": ["id", "label", "capabilities", "artifacts", "runtime"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source"],
        "properties": {
          "id": {"type": "string"},
          "format": {"type": "string", "enum": ["gguf"]},
          "source": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"type": "string", "enum": ["huggingface", "url"]},
              "repo": {"type": "string"},
              "files": {"type": "array", "items": {"type": "string"}},
              "url": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "runtime": {
      "type": "object",
      "required": ["model_ref"],
      "properties": {
        "model_ref": {"type": "string"},
        "defaults": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
