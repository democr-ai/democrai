{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llama.cpp uploaded model",
  "type": "object",
  "required": ["id", "label", "uploaded_artifact", "capabilities"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "uploaded_artifact": {
      "type": "object",
      "required": ["accept"],
      "properties": {
        "accept": {"type": "array", "items": {"type": "string", "enum": [".gguf"]}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "runtime": {"type": "object"}
  },
  "additionalProperties": true
}
