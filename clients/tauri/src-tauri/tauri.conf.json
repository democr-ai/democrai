{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Democrai",
  "version": "0.1.0",
  "identifier": "ai.democrai.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../webclient/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Democrai",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
