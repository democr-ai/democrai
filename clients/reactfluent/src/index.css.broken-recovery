}

.fluent-root h1,
.fluent-root .h1 {
  font-size: 28px;
  line-height: 36px !important;
  font-weight: 600;
  letter-spacing: 0;
}

.fluent-root h2,
.fluent-root .h2 {
  font-size: 24px;
  line-height: 32px !important;
  font-weight: 600;
  letter-spacing: 0;
}

.fluent-root h3,
.fluent-root .h3 {
  font-size: 20px;
  line-height: 28px !important;
  font-weight: 600;
  letter-spacing: 0;
}

.fluent-root h4,
.fluent-root .h4 {
  font-size: 16px;
  line-height: 22px !important;
  font-weight: 600;
  letter-spacing: 0;
}

.fluent-root h5,
.fluent-root .h5 {
  font-size: 14px;
  line-height: 20px !important;
  font-weight: 600;
  letter-spacing: 0;
}

.fluent-root h6,
.fluent-root .h6 {
  font-size: 12px;
  line-height: 16px !important;
  font-weight: 600;
  letter-spacing: 0;
}
.a2ui-recovered-missing-selector {
  margin: 0 !important;
}
.a2ui-recovered-missing-selector
.a2ui-recovered-missing-selector {
  letter-spacing: 0;
}

.a2ui-markdown,
.markdown-content {
  max-width: 100%;
  color: var(--colorNeutralForeground1);
  font-size: 14px;
  line-height: 22px;
  overflow-wrap: break-word;
  word-break: normal;
}

.a2ui-markdown > *:first-child,
.markdown-content > *:first-child {
  margin-top: 0 !important;
}

.a2ui-markdown > *:last-child,
.markdown-content > *:last-child {
  margin-bottom: 0 !important;
}

.a2ui-markdown h1,
.markdown-content h1 {
  margin: 24px 0 8px !important;
  font-size: 24px;
  line-height: 32px !important;
  font-weight: 600;
}

.a2ui-markdown h2,
.markdown-content h2 {
  margin: 20px 0 8px !important;
  font-size: 20px;
  line-height: 28px !important;
  font-weight: 600;
}

.a2ui-markdown h3,
.markdown-content h3 {
  margin: 16px 0 8px !important;
  font-size: 16px;
  line-height: 22px !important;
  font-weight: 600;
}

.a2ui-markdown h4,
.a2ui-markdown h5,
.a2ui-markdown h6,
.markdown-content h4,
.markdown-content h5,
.markdown-content h6 {
  margin: 14px 0 6px !important;
  font-size: 14px;
  line-height: 20px !important;
  font-weight: 600;
}

.a2ui-markdown p,
.markdown-content p {
  margin: 10px 0;
}

.a2ui-markdown ul,
.a2ui-markdown ol,
.markdown-content ul,
.markdown-content ol {
  margin: 10px 0;
  padding-left: 22px;
}

.a2ui-markdown li,
.markdown-content li {
  margin: 3px 0;
}

.a2ui-markdown a,
.markdown-content a {
  color: var(--colorBrandForegroundLink);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.a2ui-markdown blockquote,
.markdown-content blockquote {
  margin: 12px 0;
  padding: 2px 0 2px 12px;
  border-left: 3px solid var(--colorNeutralStroke2);
  color: var(--colorNeutralForeground2);
}

.a2ui-markdown table,
.markdown-content table {
  width: 100%;
  margin: 14px 0;
  border-collapse: collapse;
  font-size: 13px;
}

.a2ui-markdown th,
.a2ui-markdown td,
.markdown-content th,
.markdown-content td {
  padding: 6px 8px;
  border-bottom: 1px solid var(--colorNeutralStroke2);
  text-align: left;
  vertical-align: top;
}

.a2ui-markdown th,
.markdown-content th {
  color: var(--colorNeutralForeground1);
  font-weight: 600;
  background: var(--colorNeutralBackground2);
}

.a2ui-markdown :not(pre) > code,
.markdown-content :not(pre) > code {
  padding: 1px 4px;
  border: 1px solid var(--colorNeutralStroke2);
  background: var(--colorNeutralBackground2);
  color: var(--colorNeutralForeground1);
  font-size: 0.92em;
}

.a2ui-markdown pre,
.markdown-content pre {
  margin: 14px 0;
  padding: 12px;
  overflow-x: auto;
  border: 1px solid var(--colorNeutralStroke2);
  background: var(--colorNeutralBackground2);
  color: var(--colorNeutralForeground1);
  white-space: pre !important;
  overflow-wrap: normal;
  word-break: normal;
  tab-size: 2;
}

.a2ui-markdown [data-streamdown='code-block'],
.markdown-content [data-streamdown='code-block'] {
  position: relative;
  margin: 14px 0;
  padding: 0;
  border: 1px solid var(--colorNeutralStroke2);
  background: var(--colorNeutralBackground2);
}

.a2ui-markdown [data-streamdown='code-block-header'],
.markdown-content [data-streamdown='code-block-header'] {
  display: flex;
  align-items: center;
  min-height: 30px;
  padding: 0 68px 0 10px;
  border-bottom: 1px solid var(--colorNeutralStroke2);
  color: var(--colorNeutralForeground3);
  font-family: var(--a2ui-font-family-monospace);
  font-size: 12px;
}

.a2ui-markdown [data-streamdown='code-block-body'],
.markdown-content [data-streamdown='code-block-body'] {
  overflow: hidden;
  background: var(--colorNeutralBackground1);
}

.a2ui-markdown [data-streamdown='code-block-body'] pre,
.markdown-content [data-streamdown='code-block-body'] pre {
  margin: 0;
  border: 0 !important;
  background: transparent !important;
}

.a2ui-markdown [data-streamdown='code-block-actions'],
.markdown-content [data-streamdown='code-block-actions'] {
  position: absolute;
  top: 3px;
  right: 6px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 1px;
  width: auto;
  height: auto;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  color: var(--colorNeutralForeground2);
  box-shadow: none;
}

.a2ui-markdown [data-streamdown='code-block-actions'] button,
.markdown-content [data-streamdown='code-block-actions'] button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  min-width: 24px;
  padding: 0 !important;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: var(--colorNeutralForeground2);
  cursor: pointer;
}

.a2ui-markdown [data-streamdown='code-block-actions'] button:hover,
.markdown-content [data-streamdown='code-block-actions'] button:hover {
  background: var(--colorSubtleBackgroundHover);
  color: var(--colorNeutralForeground1);
}

.a2ui-markdown [data-streamdown='code-block-actions'] button:active,
.markdown-content [data-streamdown='code-block-actions'] button:active {
  background: var(--colorSubtleBackgroundPressed);
}

.a2ui-markdown pre code,
.markdown-content pre code {
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  white-space: inherit !important;
  overflow-wrap: inherit;
  word-break: inherit;
}

.a2ui-markdown pre code > span,
.markdown-content pre code > span {
  display: block;
}

