html,
body,
#root {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
}

:root {
  --a2ui-font-family-base: 'Segoe UI', 'Segoe UI Web (West European)', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', 'Source Sans 3 Variable', sans-serif;
  --a2ui-font-family-monospace: Consolas, 'Cascadia Mono', 'SFMono-Regular', 'Roboto Mono', 'Courier New', monospace;
}

* {
  box-sizing: border-box;
}
.a2ui-recovered-missing-selector body {
  font-family: var(--a2ui-font-family-base);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#root > .fui-FluentProvider,
.fluent-root,
.a2ui-app {
  width: 100%;
  height: 100%;
  min-width: 0;
  overflow-x: hidden;
}

.fluent-root {
  font-family: var(--a2ui-font-family-base);
  background: #f5f5f5 !important;
  color: var(--colorNeutralForeground1);
}

.font-monospace,
code,
kbd,
pre,
samp {
