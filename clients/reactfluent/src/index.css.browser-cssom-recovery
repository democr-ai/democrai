:focus-within { border-color: var(--colorBrandStroke1); box-shadow: inset 0 -1px 0 var(--colorBrandStroke1); }
.is-invalid { border-color: rgb(209, 52, 56); }
:hover { color: var(--colorNeutralForeground1); background: var(--colorNeutralBackground1Hover); }
i { font-size: 15px; }
.ms-TextField-fieldGroup, .ms-Dropdown-title { min-height: 32px; height: 32px; color: var(--colorNeutralForeground1); background: var(--colorNeutralBackground1); border-color: var(--colorNeutralStroke1); border-radius: 2px; }
.ms-TextField-field { height: 30px; color: var(--colorNeutralForeground1); font-size: 13px; }
.ms-Dropdown-title { line-height: 30px; font-size: 13px; }
.ms-Button { min-width: 74px; height: 32px; padding: 0px 10px; border-radius: 2px; }
.ms-Button .ms-Button-flexContainer { gap: 5px; }
html[data-client-theme="dark"], html[data-client-theme="dark"] .ms-TextField-fieldGroup, html[data-client-theme="dark"] .ms-Dropdown-title { color: rgb(243, 242, 241); background: rgb(32, 31, 30); border-color: rgb(138, 136, 134); }
html[data-client-theme="dark"] { color: rgb(243, 242, 241); background: rgb(41, 40, 39); border-color: rgb(82, 82, 82); }
html[data-client-theme="dark"] { border-left-color: rgb(82, 82, 82); }
html[data-client-theme="dark"] :hover { background: rgb(59, 58, 57); }
html[data-client-theme="dark"] .ms-TextField-field, html[data-client-theme="dark"] .ms-Dropdown-title { color: rgb(243, 242, 241); }
:hover { background: var(--colorNeutralBackground1Hover); }
.is-active { color: rgb(255, 255, 255); background: var(--colorBrandBackground); border-color: var(--colorBrandStroke1); }
.is-active .a2ui-thread-list-item-preview { color: rgba(255, 255, 255, 0.78); }
html[data-client-theme="dark"] :hover { background: rgb(41, 40, 39); }
html[data-client-theme="dark"] .is-active { color: rgb(255, 255, 255); background: rgb(0, 120, 212); border-color: rgb(96, 205, 255); }
.a2ui-drawer-top, .a2ui-drawer-bottom { right: 0px !important; left: 0px !important; width: 100vw !important; max-width: 100vw !important; margin: 0px !important; border-radius: 0px !important; }
.a2ui-drawer-top { top: 0px !important; bottom: auto !important; animation: 180ms cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running a2ui-drawer-slide-down !important; }
.a2ui-drawer-bottom { top: auto !important; bottom: 0px !important; animation: 180ms cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running a2ui-drawer-slide-up !important; }
.a2ui-drawer-top .a2ui-dialog-content, .a2ui-drawer-bottom .a2ui-dialog-content { width: 100%; max-height: inherit; overflow: auto; }
@keyframes a2ui-drawer-slide-down { 
  0% { opacity: 0; transform: translateY(-100%); }
  100% { opacity: 1; transform: translateY(0px); }
}
@keyframes a2ui-drawer-slide-up { 
  0% { opacity: 0; transform: translateY(100%); }
  100% { opacity: 1; transform: translateY(0px); }
}